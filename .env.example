# Database
POSTGRES_USER=aerovision
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=aerovision
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://aerovision:change-me-postgres-password@postgres:5432/aerovision

# Auth
JWT_SECRET_KEY=change-me-long-random-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=change-me-admin-password
ALLOW_PUBLIC_REGISTRATION=true

# Storage
STORAGE_ROOT=/app/storage
MODELS_ROOT=/app/storage/models

# Backend
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_IMAGE_SIZE_MB=20
MAX_VIDEO_SIZE_MB=500

# CV
CV_DEVICE=cpu
ACTIVE_MODEL_ID=

# Worker
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_HEARTBEAT_FRAMES=30
WORKER_HEARTBEAT_SECONDS=2
WORKER_STALE_JOB_MINUTES=10
WORKER_MAX_RETRIES=2

# Local ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT_HOST=5432

